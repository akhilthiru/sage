// Sage Database Schema
// This is the complete production-ready schema for the Sage MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  profile       FinancialProfile?
  goals         Goal[]
  expenses      Expense[]
  debts         Debt[]
  assets        Asset[]
  transactions  Transaction[]
  conversations Conversation[]
  allocations   Allocation[]
  simulations   Simulation[]

  @@index([clerkId])
  @@index([email])
}

// ============================================================================
// FINANCIAL PROFILE
// ============================================================================

model FinancialProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  
  // Income
  monthlyIncome         Decimal         @db.Decimal(12, 2)
  otherIncome           Decimal         @default(0) @db.Decimal(12, 2)
  incomeFrequency       IncomeFrequency @default(MONTHLY)
  
  // Savings
  currentSavings        Decimal         @db.Decimal(12, 2)
  emergencyFundTarget   Decimal?        @db.Decimal(12, 2)
  currentEmergencyFund  Decimal         @default(0) @db.Decimal(12, 2)
  
  // Metadata
  primaryGoal           String?
  riskTolerance         RiskTolerance   @default(MODERATE)
  cfoUnderstandingScore Int             @default(0)
  
  // Timestamps
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum IncomeFrequency {
  MONTHLY
  ANNUAL
  WEEKLY
  BIWEEKLY
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

// ============================================================================
// GOALS
// ============================================================================

model Goal {
  id                  String        @id @default(cuid())
  userId              String
  
  // Goal Details
  name                String
  description         String?
  type                GoalType
  
  // Financial
  targetAmount        Decimal       @db.Decimal(12, 2)
  currentAmount       Decimal       @default(0) @db.Decimal(12, 2)
  monthlyContribution Decimal       @default(0) @db.Decimal(12, 2)
  
  // Timeline
  targetDate          DateTime
  startDate           DateTime      @default(now())
  completedDate       DateTime?
  
  // Priority & Status
  priority            Priority      @default(MEDIUM)
  status              GoalStatus    @default(ACTIVE)
  
  // Feasibility
  isFeasible          Boolean       @default(true)
  feasibilityScore    Int           @default(100)
  
  // Metadata
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  
  // Relations
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  milestones  GoalMilestone[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([targetDate])
}

model GoalMilestone {
  id            String    @id @default(cuid())
  goalId        String
  
  // Milestone Details
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  targetDate    DateTime
  
  // Status
  isCompleted   Boolean   @default(false)
  completedDate DateTime?
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([targetDate])
}

enum GoalType {
  EMERGENCY_FUND
  HOUSE
  CAR
  VACATION
  WEDDING
  EDUCATION
  RETIREMENT
  CUSTOM
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// ============================================================================
// EXPENSES
// ============================================================================

model Expense {
  id          String          @id @default(cuid())
  userId      String
  
  // Expense Details
  name        String
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory
  frequency   Frequency       @default(MONTHLY)
  
  // Status
  isEssential Boolean         @default(false)
  isActive    Boolean         @default(true)
  
  // Timestamps
  startDate   DateTime        @default(now())
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([userId, isActive])
}

enum ExpenseCategory {
  RENT
  UTILITIES
  GROCERIES
  TRANSPORTATION
  HEALTHCARE
  INSURANCE
  ENTERTAINMENT
  DINING
  SHOPPING
  EDUCATION
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

// ============================================================================
// DEBTS
// ============================================================================

model Debt {
  id              String     @id @default(cuid())
  userId          String
  
  // Debt Details
  name            String
  type            DebtType
  principalAmount Decimal    @db.Decimal(12, 2)
  currentBalance  Decimal    @db.Decimal(12, 2)
  interestRate    Decimal    @db.Decimal(5, 2)
  
  // Payment
  monthlyPayment  Decimal    @db.Decimal(12, 2)
  minimumPayment  Decimal    @db.Decimal(12, 2)
  
  // Timeline
  startDate       DateTime
  endDate         DateTime?
  
  // Status
  status          DebtStatus @default(ACTIVE)
  
  // Timestamps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  
  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model DebtPayment {
  id            String        @id @default(cuid())
  debtId        String
  
  // Payment Details
  amount        Decimal       @db.Decimal(12, 2)
  principalPaid Decimal       @db.Decimal(12, 2)
  interestPaid  Decimal       @db.Decimal(12, 2)
  
  // Timing
  paymentDate   DateTime
  dueDate       DateTime
  
  // Status
  status        PaymentStatus @default(PENDING)
  
  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relations
  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([paymentDate])
  @@index([status])
}

enum DebtType {
  HOME_LOAN
  CAR_LOAN
  PERSONAL_LOAN
  EDUCATION_LOAN
  CREDIT_CARD
  OTHER
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  DEFAULTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  MISSED
  PARTIAL
}

// ============================================================================
// ASSETS
// ============================================================================

model Asset {
  id             String    @id @default(cuid())
  userId         String
  
  // Asset Details
  name           String
  type           AssetType
  currentValue   Decimal   @db.Decimal(12, 2)
  purchaseValue  Decimal?  @db.Decimal(12, 2)
  purchaseDate   DateTime?
  
  // Returns (for investments)
  expectedReturn Decimal?  @db.Decimal(5, 2)
  
  // Status
  isLiquid       Boolean   @default(true)
  
  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

enum AssetType {
  SAVINGS_ACCOUNT
  FIXED_DEPOSIT
  STOCKS
  MUTUAL_FUNDS
  REAL_ESTATE
  GOLD
  PPF
  EPF
  NPS
  OTHER
}

// ============================================================================
// TRANSACTIONS
// ============================================================================

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  goalId          String?
  
  // Transaction Details
  amount          Decimal         @db.Decimal(12, 2)
  type            TransactionType
  category        String?
  description     String?
  
  // Timing
  transactionDate DateTime        @default(now())
  
  // Metadata
  source          String?
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([goalId])
  @@index([transactionDate])
  @@index([userId, transactionDate])
}

enum TransactionType {
  INCOME
  EXPENSE
  GOAL_CONTRIBUTION
  DEBT_PAYMENT
  INVESTMENT
  TRANSFER
}

// ============================================================================
// ALLOCATIONS
// ============================================================================

model Allocation {
  id                String   @id @default(cuid())
  userId            String
  
  // Period
  month             Int
  year              Int
  
  // Allocation Breakdown
  essentialExpenses Decimal  @db.Decimal(12, 2)
  debtPayments      Decimal  @db.Decimal(12, 2)
  emergencyFund     Decimal  @db.Decimal(12, 2)
  goalSavings       Decimal  @db.Decimal(12, 2)
  investments       Decimal  @db.Decimal(12, 2)
  discretionary     Decimal  @db.Decimal(12, 2)
  
  // Metadata
  totalIncome       Decimal  @db.Decimal(12, 2)
  totalAllocated    Decimal  @db.Decimal(12, 2)
  
  // Status
  isActive          Boolean  @default(true)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
  @@index([year, month])
}

// ============================================================================
// CONVERSATIONS (AI CHAT)
// ============================================================================

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  
  // Conversation Details
  title     String?
  
  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  
  // Message Details
  role           MessageRole
  content        String       @db.Text
  
  // Metadata
  metadata       Json?
  
  // Timestamps
  createdAt      DateTime     @default(now())
  
  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ============================================================================
// SIMULATIONS
// ============================================================================

model Simulation {
  id          String         @id @default(cuid())
  userId      String
  
  // Simulation Details
  type        SimulationType
  parameters  Json
  results     Json
  
  // Metadata
  title       String?
  description String?
  
  // Timestamps
  createdAt   DateTime       @default(now())
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

enum SimulationType {
  PURCHASE_AFFORDABILITY
  LOAN_FEASIBILITY
  GOAL_TIMELINE
  INCOME_CHANGE
  EXPENSE_CHANGE
  RETIREMENT_PLANNING
}
