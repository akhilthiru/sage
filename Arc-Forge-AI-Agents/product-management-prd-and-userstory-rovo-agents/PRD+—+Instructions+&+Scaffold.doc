<hr local-id=3D"6eced22bcb2c">
<h2 local-id=3D"232a8b8fd22c" id=3D"PRD=E2=80=94Instructions&amp;Scaffold-1=
1.Questions">11. Questions</h2>
<div class=3D"table-wrap">
<table data-table-width=3D"760" data-layout=3D"default" data-local-id=3D"50=
9bf773ebed" class=3D"confluenceTable">
<tbody>
<tr data-local-id=3D"5453029db050">
<th data-local-id=3D"f157247134b2" class=3D"confluenceTh">
<p local-id=3D"6dcfa506b0c6">#</p></th>
<th data-local-id=3D"906f5aa50957" class=3D"confluenceTh">
<p local-id=3D"6dfd7b34a854">Question</p></th>
<th data-local-id=3D"a3d880a92341" class=3D"confluenceTh">
<p local-id=3D"27294a9fabd1">Area</p></th>
<th data-local-id=3D"4e859ecfca49" class=3D"confluenceTh">
<p local-id=3D"cfd4a7d79ef4">Owner</p></th>
<th data-local-id=3D"7fc36bae4754" class=3D"confluenceTh">
<p local-id=3D"bdb5fed44372">Date Raised</p></th>
<th data-local-id=3D"fa8e91509752" class=3D"confluenceTh">
<p local-id=3D"6e61bc21f78e">Answer</p></th>
<th data-local-id=3D"640afad811e7" class=3D"confluenceTh">
<p local-id=3D"1ea3990404ab">Answered By</p></th>
<th data-local-id=3D"2c9678f3a1f2" class=3D"confluenceTh">
<p local-id=3D"14429d3dc4e0">Answered Date</p></th>
<th data-local-id=3D"b6bd2b2573ea" class=3D"confluenceTh">
