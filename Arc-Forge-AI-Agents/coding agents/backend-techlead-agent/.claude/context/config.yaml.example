# Technical Lead Agent — Configuration
# Copy this to .claude/context/config.yaml and fill in your values.

# ─────────────────────────────────────────────
# GITHUB
# Spec files (openapi.yaml, asyncapi.yaml, db-schema.md) are read directly
# from GitHub using the gh CLI — no local repo clones required.
#
# Requires: gh CLI installed and authenticated (`gh auth login`)
# ─────────────────────────────────────────────
github:
  org: "your-github-org"       # GitHub organisation containing all service repos
  base_branch: "main"          # Branch to read specs from (e.g. main, master, develop)

# ─────────────────────────────────────────────
# JIRA
# ─────────────────────────────────────────────
jira:
  base_url: "https://yourorg.atlassian.net"
  project_key: "PROJ"
  # How FRD/HLD links are stored on Jira epics.
  # "remote_links" = added via Jira's "Link" → Confluence page feature (your setup)
  doc_link_source: "remote_links"

# ─────────────────────────────────────────────
# CONFLUENCE
# ─────────────────────────────────────────────
confluence:
  base_url: "https://yourorg.atlassian.net/wiki"
  space_key: "ENG"

# ─────────────────────────────────────────────
# SPEC FILES
#
# Each repo's specifications/ folder contains three files:
#   specifications/openapi.yaml    — current OpenAPI spec
#   specifications/asyncapi.yaml   — current AsyncAPI spec
#   specifications/db-schema.md    — current DB schema
#
# The agent searches for these filenames (and common variants) automatically.
# Only set overrides below if a specific repo uses non-standard locations.
# ─────────────────────────────────────────────
spec_files:
  openapi:   "specifications/openapi.yaml"     # primary filename to look for
  asyncapi:  "specifications/asyncapi.yaml"    # primary filename to look for
  db_schema: "specifications/db-schema.md"     # primary filename to look for

# Optional: per-repo overrides (uncomment and customise as needed)
# spec_file_overrides:
#   order-service:
#     openapi:  "docs/api.yaml"
#     asyncapi: "specifications/events.yaml"
#     db_schema: "docs/database.md"
#   payment-service:
#     db_schema: "specifications/schema.sql"

# ─────────────────────────────────────────────
# .NET STACK (auto-detected from repos — only override if detection fails)
# ─────────────────────────────────────────────
dotnet:
  target_framework: "net8.0"
  db: "sqlserver"               # sqlserver | postgresql
  migration_tool: "efcore"
  messaging: null               # null = auto-detect | azureservicebus | kafka | rabbitmq

# ─────────────────────────────────────────────
# OUTPUT
# ─────────────────────────────────────────────
output:
  base_dir: "output"

# ─────────────────────────────────────────────
# PIPELINE
# ─────────────────────────────────────────────
pipeline:
  require_human_approval_before_publish: true   # never set to false
  max_lld_revisions: 5

# ─────────────────────────────────────────────
# FIGMA
# Figma designs are linked on individual Jira user stories (not the epic).
# The agent reads them via Figma MCP automatically.
# No configuration required — MCP connection handles auth.
#
# To connect: Claude Code → Settings → Connectors → Figma
# Required Figma permission: Viewer access on the relevant files.
# ─────────────────────────────────────────────
figma:
  # If a Figma file cannot be read via MCP, halt or warn?
  # "warn" = log it, continue with acceptance-criteria-only spec for that story
  # "halt" = stop and ask user to fix access before continuing
  on_read_failure: "warn"

# ─────────────────────────────────────────────
# ESTIMATION
# ─────────────────────────────────────────────
estimation:
  unit: "hours"                   # hours | story_points | tshirt | days

  # Two human review rounds — hours added per story on top of implementation estimate
  review_rounds:
    - name: "Senior Dev Review"
      hours: 2                    # Review time + feedback + developer rework
    - name: "Tech Lead Review"
      hours: 2                    # LLD conformance check + sign-off + any final fixes

  rework_buffer:
    threshold_hours: 16           # Add rework buffer if implementation estimate >= this
    hours: 2                      # Hours added for rework round

  # Stories above this total hour value will be flagged for splitting
  split_threshold: 40
